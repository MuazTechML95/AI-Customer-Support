# ---------------------------------------------------------------------------
# .env.example
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE:
#   1. Copy this file to a new file named ".env" in the same folder:
#        cp .env.example .env      (Mac/Linux)
#        copy .env.example .env    (Windows)
#   2. Fill in your real values below (especially LLM_API_KEY).
#   3. Never commit the real ".env" file to git - it is already listed in
#      .gitignore.
# ---------------------------------------------------------------------------

# --- LLM settings -----------------------------------------------------------
# Which provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai

# Model name for the chosen provider.
# OpenAI examples: gpt-4o-mini, gpt-4o
# Anthropic examples: claude-sonnet-4-5, claude-haiku-4-5
LLM_MODEL=gpt-4o-mini

# Your secret API key. NEVER share this or commit it to version control.
LLM_API_KEY=

# Max tokens the model can generate per answer.
LLM_MAX_TOKENS=500

# Temperature (0.0 = very deterministic, 1.0 = very creative). Kept low for a
# factual support bot.
LLM_TEMPERATURE=0.2

# --- Embedding settings ------------------------------------------------------
# Local embedding model (runs offline, no API key needed for this one).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store settings ----------------------------------------------------
VECTOR_STORE_PATH=vectorstore
COLLECTION_NAME=novacart_kb

# --- RAG / retrieval settings --------------------------------------------------
KNOWLEDGE_BASE_PATH=data/knowledge_base
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
# Raise this to make the bot stricter (more "I don't have that info" answers).
# Lower it to make the bot more willing to answer from loosely related content.
SIMILARITY_THRESHOLD=0.35

# --- Session settings -----------------------------------------------------------
MAX_HISTORY_TURNS=5

# --- App branding ------------------------------------------------------------------
APP_NAME=SupportAI
COMPANY_NAME=NovaCart

# --- Debug mode (set to true to see full error tracebacks in the UI) ---------------
DEBUG=false
